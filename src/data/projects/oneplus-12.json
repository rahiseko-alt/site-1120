      "description": [
        {
          "type": "paragraph",
          "text": "A First Look launch film for the OnePlus 12, themed Inspired by Nature, shot on location in New Zealand.",
          "spans": [],
          "direction": "ltr"
        }
      ],
      "detail_description": [
        {
          "type": "paragraph",
          "text": "The film weaves the serenity and power of New Zealand's natural landscapes with the OnePlus 12's design philosophy. It alternates between intimate close-ups and sweeping wide shots, blending human emotion with nature as a metaphor for the phone's pioneering spirit. Concept to production was executed in just two weeks, with only four hours of shoot time per day.",
          "spans": [],
          "direction": "ltr"
        }
      ],
