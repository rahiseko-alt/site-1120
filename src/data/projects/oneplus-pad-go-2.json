      "description": [
        {
          "type": "paragraph",
          "text": "PAD GO 2 is a next-generation large-screen productivity companion built for today’s generation of learners, creators, and doers who live fluidly between study, work, and play.",
          "spans": [],
          "direction": "ltr"
        }
      ],
      "detail_description": [
        {
          "type": "paragraph",
          "text": "Today’s users don’t have boundaries between study, work, and leisure. ",
          "spans": [],
          "direction": "ltr"
        },
        {
          "type": "paragraph",
          "text": "They move between spaces, roles, and moods — sometimes in seconds.",
          "spans": [],
          "direction": "ltr"
        },
        {
          "type": "paragraph",
          "text": "“Designed for your flow” means the Pad adapts with them — from dorm room to cafeteria, from the court to restaurant, from playtime to deadline — never breaking their stride.",
          "spans": [],
          "direction": "ltr"
        }
      ],
