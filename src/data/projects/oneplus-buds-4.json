      "description": [
        {
          "type": "paragraph",
          "text": "The film introduces an all-new audio experience, redefining the way we listen, move, and feel music.",
          "spans": [],
          "direction": "ltr"
        }
      ],
      "detail_description": [
        {
          "type": "paragraph",
          "text": "This is a cinematic product film that goes beyond showcasing specifications. It is a sensory journey — one that translates the invisible world of sound into something visceral, visual, and deeply personal. At its core, the film is built around a single idea: that truly great audio doesn't just accompany your life, it transforms it. The OnePlus Buds 4 is positioned not merely as a product, but as a gateway to a richer, more immersive way of experiencing the world around you.",
          "spans": [],
          "direction": "ltr"
        }
      ],
