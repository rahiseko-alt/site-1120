      "description": [
        {
          "type": "paragraph",
          "text": "Design and 3D visual branding for 88rising's Heads in the Clouds festival in LA — billboards, festival maps, ad mats, and flyers.",
          "spans": [],
          "direction": "ltr"
        }
      ],
      "detail_description": [
        {
          "type": "paragraph",
          "text": "Originally scoped to cover all 88rising festivals across Jakarta, Sydney, Chengdu, and LA, the project ultimately focused on the LA edition. The team delivered typography banners, striking posters, intricate festival maps, and headliner/sponsor advertisements — capturing LA's diversity, laid-back energy, and playful spirit, while reinforcing 88rising's identity as a pioneer in the Asian music scene.",
          "spans": [],
          "direction": "ltr"
        }
      ],
