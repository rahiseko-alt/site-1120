      "description": [
        {
          "type": "paragraph",
          "text": "A two-year collaboration producing globally-targeted sneaker campaign films and content, made entirely in Shanghai.",
          "spans": [],
          "direction": "ltr"
        }
      ],
      "detail_description": [
        {
          "type": "paragraph",
          "text": "What began as content for the Chinese market expanded into monthly global sneaker drops for both men and women. The team developed a streamlined three-week pipeline — from creative concept to final production — to meet LV's monthly cadence. Content was designed to work across LV's website, in-store displays, and WeChat mini programs, ensuring a cohesive global brand experience.",
          "spans": [],
          "direction": "ltr"
        }
      ],
