      "description": [
        {
          "type": "paragraph",
          "text": "Creative identity for LASALLE's 2023 graduation show Rise Above, representing eight academic programs through animated CGI objects.",
          "spans": [],
          "direction": "ltr"
        }
      ],
      "detail_description": [
        {
          "type": "paragraph",
          "text": "The team reimagined eight objects/elements to symbolise each of LASALLE's eight programs, then animated and composited them around the theme Rise Above. A fluid line divides two contrasting states — Rising and Stable — complemented by mixed typography (sans serif and serif). All assets rendered in 8K for use across campus posters, banners, and infrastructure.",
          "spans": [],
          "direction": "ltr"
        }
      ],
