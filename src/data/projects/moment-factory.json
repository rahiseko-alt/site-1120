      "name": "Oriens Lumina Walks",
      "client": {
        "link_type": "Document"
      },
      "description": [
        {
          "type": "paragraph",
          "text": "The 16th in Moment Factory's Lumina night walk series — and its first in China — an immersive multimedia journey through ancient Chinese mythology in Shanghai.",
          "spans": [],
          "direction": "ltr"
        }
      ],
      "detail_description": [
        {
          "type": "paragraph",
          "text": "Located at the Nine Trees Future Art Centre in Fengxian, Shanghai, the experience transforms a forest into a multisensory journey through the five elements and Chinese mythology. fromanother served as the local partner handling installation, lighting, and on-the-ground production via remote collaboration, as Moment Factory's Montreal team could not travel due to COVID-19.",
          "spans": [],
          "direction": "ltr"
        }
      ],
