      "description": [
        {
          "type": "paragraph",
          "text": "The film captures the relentless energy of a generation that moves fast, plays hard, and refuses to be unplugged. ",
          "spans": [],
          "direction": "ltr"
        }
      ],
      "detail_description": [
        {
          "type": "paragraph",
          "text": "The earphone's design not only ensures stability during use but also serves as the creative spark for the film's concept and art direction.",
          "spans": [],
          "direction": "ltr"
        },
        {
          "type": "paragraph",
          "text": "Dynamic energy swirls and vibrant gradients become central visual elements, capturing the energetic, fast-paced lifestyle of our character. Every scene, every beat, every frame is designed to mirror the stamina of the product itself — powered to play all day.",
          "spans": [],
          "direction": "ltr"
        }
      ],
