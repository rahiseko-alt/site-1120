      "name": "Perfection at Play",
      "client": {
        "link_type": "Document"
      },
      "description": [
        {
          "type": "paragraph",
          "text": "Campaign presenting the OnePlus Buds Pro 3 as a luxury, high-fashion accessory for audiophiles who value both style and sound.",
          "spans": [],
          "direction": "ltr"
        }
      ],
      "detail_description": [
        {
          "type": "paragraph",
          "text": "The film demonstrates how the Buds Pro 3 transforms everyday noise into mastery — transitioning from a noisy backdrop to a serene personal haven, highlighting noise cancellation, spatial audio, and head-tracking. The team also handled art direction for the product launch key visual (KV), teaser visual, lifestyle KVs (shot with Invisible Studio), and CGI-animated Key Features KVs.",
          "spans": [],
          "direction": "ltr"
        }
      ],
