      "name": "Cartier Christmas Minisite",
      "client": {
        "link_type": "Document"
      },
      "description": [
        {
          "type": "paragraph",
          "text": "The minisite translates Cartier’s iconic unboxing ritual into a refined digital journey, showcasing a curated selection of nine products and guiding users naturally toward in-store discovery.",
          "spans": [],
          "direction": "ltr"
        }
      ],
      "detail_description": [
        {
          "type": "paragraph",
          "text": "A mobile-first digital experience designed to extend the physical gifting ritual into the digital space, the minisite translates Cartier's iconic unboxing moment into a refined digital journey — guiding users through a curated selection of nine products and connecting digital discovery seamlessly to in-store purchase across key Asia-Pacific markets, while preserving the brand's physical values in an experience that feels consistent, intuitive, and enduring.",
          "spans": [],
          "direction": "ltr"
        }
      ],
